# Server-only secrets — never put these in EXPO_PUBLIC_* or commit real values.
# Rotate any key that was previously embedded in the mobile .env.

# whisper (default) | bharatgen
SPEECH_PROVIDER=whisper

# Prefer Groq for cost / MVP
GROQ_API_KEY=gsk_...

# Or OpenAI for higher accuracy (gpt-4o-transcribe)
# OPENAI_API_KEY=sk-...

# Optional overrides
# STT_MODEL=whisper-large-v3
# CHAT_MODEL=llama-3.3-70b-versatile
# PORT=8787
# MAX_UPLOAD_BYTES=26214400

# BharatGen — leave empty until an official hosted API exists.
# Do not invent a URL. Self-host Shrutam-2 is not a drop-in REST API.
BHARATGEN_API_KEY=
BHARATGEN_API_URL=
BHARATGEN_SPEECH_MODEL=
