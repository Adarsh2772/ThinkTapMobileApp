# Free testing (client-side MVP) — preferred for local dev
# Prefer the production proxy (EXPO_PUBLIC_API_URL) so keys never ship in the app binary.
# Rotate any key that was ever committed under EXPO_PUBLIC_*.
EXPO_PUBLIC_GROQ_API_KEY=

# Paid option (OpenAI gpt-4o-transcribe) — client-side only for local testing
# EXPO_PUBLIC_OPENAI_API_KEY=sk-...

# Production: point at the ThinkTap STT proxy (see server/README.md)
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8787

# Transcript analysis (Summary page buckets). Defaults to production if unset.
# EXPO_PUBLIC_TRANSCRIPT_ANALYZE_URL=https://thinktapai.shastrarth.in/api/v1/transcripts/analyze

# Force demo transcripts even if a key exists
# EXPO_PUBLIC_USE_MOCK_AI=true
