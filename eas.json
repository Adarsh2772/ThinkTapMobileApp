{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SARVAM_API_KEY": "",
        "EXPO_PUBLIC_SARVAM_MODEL": "saaras:v3",
        "EXPO_PUBLIC_SARVAM_CHAT_MODEL": "sarvam-105b"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SARVAM_API_KEY": "",
        "EXPO_PUBLIC_SARVAM_MODEL": "saaras:v3",
        "EXPO_PUBLIC_SARVAM_CHAT_MODEL": "sarvam-105b"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
