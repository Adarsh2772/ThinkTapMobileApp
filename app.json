{
  "expo": {
    "name": "Think Tap",
    "slug": "think-tap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thinktap",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thinktap.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Think Tap to use the microphone for Hey Think Tap.",
        "NSSpeechRecognitionUsageDescription": "Allow Think Tap to recognize Hey Think Tap to start recording."
      }
    },
    "android": {
      "package": "com.thinktap.app",
      "adaptiveIcon": {
        "backgroundColor": "#f9f9ff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f9f9ff"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Think Tap to access your microphone to record ideas."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Think Tap to use the microphone for Hey Think Tap.",
          "speechRecognitionPermission": "Allow Think Tap to recognize Hey Think Tap to start recording."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd732775-e3c1-4d25-b564-a4e46e49d13b"
      }
    },
    "owner": "adarsh1005"
  }
}
