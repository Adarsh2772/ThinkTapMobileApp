{
  "expo": {
    "name": "Think Tap",
    "slug": "think-tap",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thinktap",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thinktap.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Think Tap to use the microphone for speech transcription and Hey Think Tap.",
        "NSSpeechRecognitionUsageDescription": "Allow Think Tap to convert your spoken ideas to text in your chosen language."
      }
    },
    "android": {
      "package": "com.thinktap.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 240
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Think Tap to access your microphone to record ideas."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Think Tap to use the microphone for speech transcription and Hey Think Tap.",
          "speechRecognitionPermission": "Allow Think Tap to convert your spoken ideas to text in your chosen language.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95838f4c-4f7e-4286-9e69-52cc008a7d66"
      }
    },
    "owner": "akkshay14"
  }
}
